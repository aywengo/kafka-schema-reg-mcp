{
  "mcpServers": {
    "kafka-schema-reg-stable": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "SCHEMA_REGISTRY_URL",
        "-e",
        "SCHEMA_REGISTRY_USER",
        "-e",
        "SCHEMA_REGISTRY_PASSWORD",
        "-e",
        "MCP_EDITION",
        "aywengo/kafka-schema-reg-mcp:stable"
      ],
      "env": {
        "SCHEMA_REGISTRY_URL": "http://host.docker.internal:38081",
        "SCHEMA_REGISTRY_USER": "",
        "SCHEMA_REGISTRY_PASSWORD": "",
        "MCP_EDITION": "viewer"
      }
    }
  }
}
